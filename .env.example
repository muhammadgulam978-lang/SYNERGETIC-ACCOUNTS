SYNERGETIC_SECRET_KEY=replace-with-a-long-random-value
SYNERGETIC_DEBUG=0
SYNERGETIC_ALLOWED_HOSTS=127.0.0.1,localhost,.vercel.app
SYNERGETIC_CSRF_TRUSTED_ORIGINS=https://localhost,https://127.0.0.1,https://*.vercel.app
SYNERGETIC_DB_NAME=synergetic_accounts
SYNERGETIC_DB_USER=synergetic_app
SYNERGETIC_DB_PASSWORD=
SYNERGETIC_DB_HOST=
SYNERGETIC_DB_PORT=5432
SYNERGETIC_DB_CONN_MAX_AGE=60
# Optional local fallback only; PostgreSQL is the default.
SYNERGETIC_USE_SQLITE=0

# Recommended on Vercel: connect a managed PostgreSQL integration and expose one
# of DATABASE_URL, POSTGRES_URL, POSTGRES_PRISMA_URL, or POSTGRES_URL_NON_POOLING.
# The URL takes precedence over the individual SYNERGETIC_DB_* values above.
# DATABASE_URL=postgresql://user:password@host/database?sslmode=require
